{
  // 隨身助理記事本（fieldlog）— 與 medtec-2026 完全獨立的 Worker
  // 部署前要改的：把下方 database_id 換成新建 D1 資料庫的 UUID（見 README）
  "name": "fieldlog",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-01",
  // 保留 Dashboard 設定的 FIELD_PIN 與 Cloudflare API Token 等 Secret／變數。
  "keep_vars": true,
  "vars": {
    // Account ID 不是機密；放進部署設定，確保分支預覽也能查用量。
    "CLOUDFLARE_ACCOUNT_ID": "a791952f49fcd61ca18b9a82dda12dd1"
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // /wiki/* 要先進 Worker 做 PIN 驗證才放行。
    // App 殼（index.html／app.js／style.css 等）也要先進 Worker——不是為了改寫內容
    // （整併後已經不需要），是因為「不先進 Worker」＝ Cloudflare Assets 直接回應，
    // Worker 完全不會執行，就沒機會蓋掉 Assets 預設的快取表頭。這幾個檔案幾乎每次
    // 部署都會變，被瀏覽器／CDN 快取住會讓使用者看到舊版介面卻毫無錯誤或提示
    // （2026-07-25 實際發生過：部署確認是最新版，前台卻還是舊畫面）。
    "run_worker_first": [
      "/wiki/*", "/", "/index.html", "/app.js", "/style.css",
      "/pdf-editor.js", "/home.css", "/sw.js", "/manifest.json", "/help.html",
      "/wiki.html", "/patrol.html"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fieldlog",
      "database_id": "41483c93-9398-4be6-a670-a3120c880781"
    },
    // 唯讀共綁 medtec-2026 的 D1（D1 允許多個 Worker 綁同一庫，跟 mcp/wrangler.jsonc 手法一樣）。
    // 只給 POST /api/admin/import-exhibitors 這支一次性匯入用，讀展商團隊狀態／拜訪紀錄／附件擷取文字。
    {
      "binding": "DB_MEDTEC",
      "database_name": "medtec-2026",
      "database_id": "bbb39534-bcf7-45b3-b068-60be5c3b198b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "fieldlog-files"
    }
  ],
  "ai": { "binding": "AI" },
  // 語意搜尋：附件／記事內容向量化後存在這裡，查詢時算相似度。
  // fieldlog-embeddings 索引已在 Cloudflare 帳號建好，確認為 1024 維／
  // cosine，跟 @cf/baai/bge-m3 這個 embedding 模型的輸出維度相符。
  // 索引裡殘留先前放棄版本留下的舊向量（ID 格式不同，不會被新代碼覆寫），
  // 對搜尋結果最多只是多幾筆不相關的候選，之後有空可以手動清空重建。
  "vectorize": [
    { "binding": "VECTOR_INDEX", "index_name": "fieldlog-embeddings" }
  ],
  // 向量化本身跑在背景（EmbeddingWorkflow），失敗不擋主要的寫入/OCR 流程。
  "workflows": [
    { "name": "fieldlog-embedding-workflow", "binding": "EMBEDDING_WORKFLOW", "class_name": "EmbeddingWorkflow" }
  ],
  // 每天 UTC 18:00（台灣 02:00）自動同步 sources 表裡的外部來源（litdb 等）。
  // 「記得手動跑同步」不是機制；handler 是 src/worker.js 的 scheduled()。
  "triggers": { "crons": ["0 18 * * *"] },
  // 展商主檔（exhibitors.json）是靜態資料、不在 D1 裡，一樣是 Service Binding，
  // 只給匯入用的 admin endpoint 呼叫，跟 mcp/wrangler.jsonc 的作法相同。
  "services": [
    { "binding": "MEDTEC", "service": "medtec-2026" }
  ]
}
